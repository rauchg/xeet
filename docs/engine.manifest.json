      ],
      "modes": [
        {
          "note": "returns a reference",
          "output": [
            "application/vnd.xeet-artifact+ref",
            "application/json"
          ],
          "select": {}
        }
      ],
      "outcomes": [
        "import an artifact",
        "add an artifact to the store",
        "load a package"
      ],
      "outputSchema": {
        "properties": {
          "artifact": {
            "description": "artifact://sha256/<hex>",
            "type": "string"
          },
          "derivedFrom": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "subject": {
            "type": "object"
          },
          "verification": {
            "properties": {
              "failed": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "ok": {
                "type": "boolean"
              },
              "skipped": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "ok",
              "failed"
            ],
            "type": "object"
          }
        },
        "required": [
          "artifact",
          "id",
          "verification"
        ],
        "type": "object"
      },
      "preconditions": [
        "path inside an allowed read root"
      ],
      "summary": "Verify an artifact package from a path and add it to the store.",
      "title": "Ingest an existing artifact package",
      "version": "0.1"
    },
    {
      "authority": [
        "store:read"
      ],
      "consequential": false,
      "constraints": {
        "deterministic": true,
        "maxInputBytes": 16777216,
        "network": "none",
        "notes": []
      },
      "description": "The authoritative structured form, unprojected. For a compact or budgeted reading, use representation.understand.",
      "effects": "none",
      "errors": [
        "invalid_input",
        "not_found",
        "unauthorized",
        "limit_exceeded"
      ],
      "guarantees": [
        "the document is returned exactly as stored; its id can be re-derived with representation.verify"
      ],
      "id": "representation.inspect",
      "inputModalities": [
        "application/vnd.xeet-artifact+ref"
      ],
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "description": "An artifact id (sha256:<hex>), its URI (artifact://sha256/<hex>), or a package directory path inside a read root the host allows (needs fs:read).",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "artifact"
        ],
        "type": "object"
      },
      "limitations": [],
      "modes": [
        {
          "note": "the document",
          "output": [
            "application/json"
          ],
          "select": {}
        }
      ],
      "outcomes": [
        "inspect an artifact",
        "get the raw artifact document",
        "full provenance and assets",
        "read the artifact json"
      ],
      "outputSchema": {
        "properties": {
          "artifact": {
            "type": "string"
          },
          "document": {
            "type": "object"
          }
        },
        "required": [
          "artifact",
          "document"
        ],
        "type": "object"
      },
      "preconditions": [],
      "summary": "Return the complete artifact document (subject, provenance, views, semantic graph, state, capabilities, limitations, coverage, assets) as stored.",
      "title": "Inspect an artifact document",
      "version": "0.1"
    },
    {
      "authority": [
        "store:read"
      ],
      "consequential": false,
      "constraints": {
        "deterministic": true,
        "maxInputBytes": 16777216,
        "network": "none",
        "notes": [
          "typical latency a few milliseconds"
        ]
      },
      "description": "A deterministic projection. Text-only consumers receive everything except pixels, plus an explicit list of content that exists only as pixels. Vision consumers additionally receive the view image; anything read from it is inference. Supports a focus element, depth, sections, and character budgets for small context windows; omissions are always listed.",
      "effects": "none",
      "errors": [
        "invalid_input",
        "not_found",
        "unauthorized",
        "limit_exceeded"
      ],
      "guarantees": [
        "deterministic: same artifact and request give the same bytes",
        "element ids are the artifact's ids",
        "basis marks distinguish source, derived, observed, inferred and unknown",
        "provenance header is never dropped; every omission is listed"
      ],
      "id": "representation.understand",
      "inputModalities": [
        "application/vnd.xeet-artifact+ref"
      ],
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "description": "An artifact id (sha256:<hex>), its URI (artifact://sha256/<hex>), or a package directory path inside a read root the host allows (needs fs:read).",
            "minLength": 1,
            "type": "string"
          },
          "compactCapabilities": {
            "type": "boolean"
          },
          "consumer": {
            "default": "text",
            "description": "text: no pixels, everything else; vision: also returns the image(s)",
            "enum": [
              "text",
              "vision"
            ]
          },
          "depth": {
            "minimum": 0,
            "type": "integer"
          },
          "focus": {
            "description": "element id; its ancestors are kept as context",
            "type": "string"
          },
          "format": {
            "default": "text",
            "enum": [
              "text",
              "json"
            ]
          },
          "maxChars": {
            "description": "total budget; filled by priority, omissions listed",
            "minimum": 1,
            "type": "integer"
          },
          "maxText": {
            "description": "truncate any single string, saying so",
            "minimum": 1,
            "type": "integer"
          },
          "sections": {
            "items": {
              "enum": [
                "elements",
                "layout",
                "relations",
                "state",
                "capabilities",
                "limitations",
                "consumers"
              ]
            },
            "type": "array"
          }
        },
        "required": [
          "artifact"
        ],
        "type": "object"
      },
      "limitations": [
        "content marked visual-only is not readable as text by anyone; vision readings are inference"
      ],
      "modes": [
        {
          "note": "line-oriented text; works for any model",
          "output": [
            "text/plain"
          ],
          "select": {
            "consumer": "text",
            "format": "text"
          }
        },
        {
          "note": "the same projection, typed",
          "output": [
            "application/json"
          ],
          "select": {
            "consumer": "text",
            "format": "json"
          }
        },
        {
          "note": "image(s) plus the same text",
          "output": [
            "image/png",
            "text/plain"
          ],
          "select": {
            "consumer": "vision"
          }
        }
      ],
      "outcomes": [
        "understand a screenshot without vision",
        "read visual information as text",
        "describe what is on screen",
        "text representation of an image",
        "make visual content readable by a text-only model",
        "summarize an artifact for a small context window",
        "get layout and positions as text",
        "what does this artifact contain",
        "read the state of a pull request",
        "get the semantic content"
      ],
      "outputSchema": {
        "properties": {
          "artifact": {
            "type": "string"
          },
          "delivery": {
            "description": "what this projection delivered and left out",
            "required": [
              "chars",
              "elementsIncluded",
              "omitted",
              "inferred",
              "visualOnly"
            ],
            "type": "object"
          },
          "format": {
            "enum": [
              "text",
              "json"
            ]
          },
          "images": {
            "items": {
              "properties": {
                "data": {
                  "description": "base64",
                  "type": "string"
                },
                "mediaType": {
                  "type": "string"
                },
                "view": {
                  "type": "string"
                }
              },
              "required": [
                "view",
                "mediaType",
                "data"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "projection": {
            "type": [
              "string",
              "object"
            ]
          }
        },
        "required": [
          "artifact",
          "format",
          "projection"
        ],
        "type": "object"
      },
      "preconditions": [],
      "summary": "Get an artifact's full meaning as text or JSON — elements, positions, layout rows, state, capabilities, limitations — without needing vision; optionally with the image.",
      "title": "Understand an artifact (projection for a consumer)",
      "version": "0.1"
    },
    {
      "authority": [
