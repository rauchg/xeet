{
  "authority": {
    "scopes": [
      {
        "id": "store:read",
        "meaning": "read artifacts in the provider's store"
      },
      {
        "id": "store:write",
        "meaning": "add artifacts to the store (never modify or delete)"
      },
      {
        "id": "fs:read",
        "meaning": "read files and package directories inside the read roots the host allows"
      }
    ],
    "summary": "Discovery grants nothing. The host that starts the provider grants scopes for a session; every invocation checks the scopes its contract names and fails with `unauthorized` listing the missing ones. No capability acts at a source system."
  },
  "capabilities": [
    {
      "authority": [
        "store:write"
      ],
      "consequential": false,
      "constraints": {
        "deterministic": true,
        "maxInputBytes": 16777216,
        "network": "none",
        "notes": [
          "typical latency tens of milliseconds"
        ]
      },
      "description": "The caller supplies the source data inline (`data`) or as a file path inside an allowed read root (`path`); the provider never fetches. The result is stored content-addressed and verified, including byte-for-byte reproduction of its view, before it is returned.",
      "effects": "creates-artifact",
      "errors": [
        "invalid_input",
        "not_found",
        "unauthorized",
        "limit_exceeded",
        "verification_failed",
        "unsupported"
      ],
      "guarantees": [
        "the stored artifact passed verification, including reproduction of its view from the preserved input",
        "same input and capturedAt give the same artifact id",
        "source bytes are preserved verbatim in the artifact"
      ],
      "id": "representation.capture",
      "inputModalities": [
        "application/json",
        "image/png",
        "image/jpeg",
        "image/gif",
        "image/webp"
      ],
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "capturedAt": {
            "description": "ISO 8601 observation time; defaults to the host clock",
            "type": "string"
          },
          "data": {
            "description": "x.post: a model::Post or `xeet resolve` output; github.pull_request: {pull, reviews?, comments?, files?, commits?, apiVersion?} of REST responses",
            "type": "object"
          },
          "dataBase64": {
            "description": "image: the file's bytes, base64",
            "type": "string"
          },
          "declaredType": {
            "description": "image: a declared media type (recorded and checked against the bytes, not trusted)",
            "type": "string"
          },
          "method": {
            "description": "how the data was obtained: draft, source-payload, api-response, fixture",
            "type": "string"
          },
          "name": {
            "description": "image: a declared filename (recorded, not trusted)",
            "type": "string"
          },
          "options": {
            "additionalProperties": false,
            "properties": {
              "scale": {
                "description": "device pixels per layout unit (default 2)",
                "maximum": 3,
                "minimum": 1,
                "type": "number"
              },
              "surface": {
                "description": "x.post only",
                "enum": [
                  "web-timeline",
                  "web-detail",
                  "ios-timeline",
                  "ios-detail"
                ]
              },
              "theme": {
                "enum": [
                  "light",
                  "dark"
                ]
              },
              "width": {
                "description": "layout width (CSS px for x.post, default 600)",
                "minimum": 1,
                "type": "number"
              }
            },
            "type": "object"
          },
          "path": {
            "description": "a file with the same content, inside an allowed read root (needs fs:read)",
            "type": "string"
          },
          "reference": {
            "description": "x.post: the post URL, if known",
            "type": "string"
          },
          "source": {
            "enum": [
              "x.post",
              "github.pull_request",
              "image"
            ]
          },
          "sourceId": {
            "description": "x.post: the status id, if known",
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "type": "object"
      },
      "limitations": [
        "three source types today: x.post, github.pull_request, image",
        "image: identifies format and dimensions and keeps the bytes; does NOT read the content (visual-only until annotated)",
        "no network: source data must be supplied",
        "authenticity of the source data is recorded as unverified"
      ],
      "modes": [
        {
          "note": "returns a reference; use representation.understand to read it",
          "output": [
            "application/vnd.xeet-artifact+ref",
            "application/json"
          ],
          "select": {}
        }
      ],
      "outcomes": [
        "capture an observation",
        "make a screenshot an agent can understand",
        "turn a post into structured data",
        "represent a pull request",
        "create an artifact",
        "convert source data into a visual and semantic representation",
        "render a post with semantics",
        "snapshot a pull request",
        "represent an image file",
        "ingest an image",
        "identify and measure an image"
      ],
      "outputSchema": {
        "properties": {
          "artifact": {
            "description": "artifact://sha256/<hex>",
            "type": "string"
          },
          "derivedFrom": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "subject": {
            "type": "object"
          },
          "verification": {
            "properties": {
              "failed": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "ok": {
                "type": "boolean"
              },
              "skipped": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "ok",
              "failed"
            ],
            "type": "object"
          }
        },
        "required": [
          "artifact",
          "id",
          "verification"
        ],
        "type": "object"
      },
      "preconditions": [
        "exactly one of data, dataBase64 or path",
        "path inputs also need fs:read and must lie inside an allowed read root"
      ],
      "summary": "Turn source data (an X post, a GitHub pull request, an image file) into a verified artifact: a visual view plus semantics, state, provenance, capabilities and limitations.",
      "title": "Capture an observation as an artifact",
      "version": "0.1"
    },
    {
      "authority": [
        "store:write",
        "fs:read"
      ],
      "consequential": false,
      "constraints": {
        "deterministic": true,
        "maxInputBytes": 16777216,
        "network": "none",
        "notes": []
      },
      "description": "Runs full verification, with reproduction when an adapter for the artifact is available, and refuses the package if any check fails.",
      "effects": "creates-artifact",
      "errors": [
        "invalid_input",
        "not_found",
        "unauthorized",
        "limit_exceeded",
        "verification_failed",
        "unsupported"
      ],
      "guarantees": [
        "nothing failing verification enters the store"
      ],
      "id": "representation.ingest",
      "inputModalities": [
