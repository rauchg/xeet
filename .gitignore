# Keep temporary playground cache, raw HTML captures, and upstream JS bundles
# out of git; commit only the runtime build inputs (fonts, icons, tokens,
# default avatar) in the private repo so git clone, Vercel CI, and GitHub CI
# build hermetically without external blob storage.
/assets/vendor/*
!/assets/vendor/fonts/
!/assets/vendor/icons.json
!/assets/vendor/tokens.json
!/assets/vendor/default-avatar.png

/oracle/out/
/oracle/.cache/
*.png.actual
*.tgz
.DS_Store

